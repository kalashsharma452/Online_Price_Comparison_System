
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/price_intelligence

# Provider selection
PRICE_PROVIDER_MODE=free_public_apis_with_mock_fallback

# eBay official API
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_ENV=sandbox
# Master switch (also accepts legacy alias: EBAY=true/false)
ENABLE_EBAY=true
ENABLE_EBAY_OFFICIAL=false
ENABLE_EBAY_SCRAPER=false

# Best Buy official API
BESTBUY_API_KEY=your_bestbuy_api_key

# Optional legacy key (if using RapidAPI adapter)
RAPID_API_KEY=your_rapidapi_key
