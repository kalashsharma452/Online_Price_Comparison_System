
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/price_intelligence
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=price-intel
API_RESPONSE_CACHE_SECONDS=180
USER_DASHBOARD_CACHE_SECONDS=120
POPULAR_SEARCH_CACHE_SECONDS=300
UPLOAD_CDN_BASE=https://cdn.example.com/uploads
SCRAPER_MAX_WORKERS=3
SCRAPE_RESULT_LIMIT=30
EBAY_TIMEOUT_SECONDS=12
COMPRESS_LEVEL=6
SLOW_REQUEST_MS=750
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
SECRET_KEY=change_me
CREDENTIALS_ENCRYPTION_KEY=base64_urlsafe_32byte_key
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_COMMAND=clamscan
ALLOW_FAKE_TEST_UPLOADS=false

# Provider selection
PRICE_PROVIDER_MODE=free_public_apis_with_mock_fallback

# eBay official API
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_ENV=sandbox
# Master switch (also accepts legacy alias: EBAY=true/false)
ENABLE_EBAY=true
ENABLE_EBAY_OFFICIAL=false
ENABLE_EBAY_SCRAPER=false

# Best Buy official API
BESTBUY_API_KEY=your_bestbuy_api_key

# Optional legacy key (if using RapidAPI adapter)
RAPID_API_KEY=your_rapidapi_key
